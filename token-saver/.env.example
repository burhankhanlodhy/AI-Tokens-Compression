# token-saver proxy configuration
# Copy to .env and fill in. NEVER commit the real .env.

# Upstream provider: OpenRouter (OpenAI-compatible). The client's own API key
# is forwarded per-request via the Authorization header — the proxy stores nothing.
UPSTREAM_BASE_URL=https://openrouter.ai/api/v1

# Feature flags
COMPRESSION_ENABLED=true
# L1 lossless structural cleanup (whitespace-compacted JSON, dup/empty system
# removal, dead RAG-metadata drop — l1-taxonomy.md v1.1). ON by default since
# B-26; losslessness is enforced by the §6 contract tests. Caveat: a message
# whose ENTIRE content is pretty-printed JSON (no surrounding prose) gets
# whitespace-compacted. Set false to disable entirely.
L1_ENABLED=true
# Phase C semantic caching is OFF by default. Do not enable until the AC-PC4
# no-cross-tenant, calibration, invalidation, and filtered-HNSW plan/latency
# gates are green; clients have no request-level override.
SEMANTIC_CACHE_ENABLED=false
# Keys & Tenants dashboard writes require this bearer token. Set a stable
# value to avoid the boot-generated token; when blank/unset it is generated
# once at startup and printed once to the proxy log (never persisted).
ADMIN_TOKEN=
# Output conciseness: OFF by default per P1-1 benchmark (no reliable savings;
# benchmarked -1.53%/-2.45% mean output change on z-ai/glm-5.3-flash). The
# X-Token-Saver-Conciseness request header can enable it per-request.
OUTPUT_CONCISENESS_ENABLED=false
# P6-3 benchmark-ONLY dose-pin gate: when true, the proxy honors the
# x-token-saver-dose-pin control header (run_benchmark.py --dose-pin).
# Leave UNSET/false in every standing deployment (production default):
# set it true only temporarily on the benchmark/calibration instance for
# the authorized $2.64 calibration run, then bring it back down. With it
# false the pin header is silently ignored (AC-P6c(2) — the pin can never
# self-raise a tier on real traffic).
# ALLOW_DOSE_PIN=false

# P6-6 measurement-instrument stamp: when set, every ledger row this
# deployment writes is tagged with this value and /api/tripwire EXCLUDES
# tagged rows from the live population — set it on the benchmark/calibration
# instance (e.g. TOKEN_SAVER_MEASUREMENT_TAG=ac_p6c_calibration) so harness
# traffic never feeds the dose-drift / missed-grounding live population.
# Leave UNSET in the production config: untagged = organic traffic.
# TOKEN_SAVER_MEASUREMENT_TAG=

# Suppress hidden reasoning/thinking tokens on models that support them
# (e.g. glm-5.3-flash), unless the client's own request already sets a
# `reasoning` field. Reasoning-token spend is unpredictable and can dwarf
# anything compression saves, so this keeps cost estimates meaningful.
DISABLE_REASONING_BY_DEFAULT=true

# Compression tuning
LLMLINGUA_MODEL=microsoft/llmlingua-2-bert-base-multilingual-cased-meetingbank
COMPRESSION_RATE=0.6

# Postgres ledger/cache (required for Phase A ledger features and tests).
# CHOOSE YOUR OWN PASSWORD before first run: set POSTGRES_PASSWORD below to a
# non-empty value of your choice. It must not be left empty — Compose refuses
# to start (`POSTGRES_PASSWORD must be set in .env`) and local runs fail fast.
# The two DSN lines interpolate it, so this is the only place it lives.
# Never commit .env with a real password.
POSTGRES_PASSWORD=
TOKEN_SAVER_PG_DSN=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5433/token_saver
TOKEN_SAVER_PG_BASE=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5433

# Harness/benchmark ONLY (run_benchmark.py, measure_sd.py read this name). The
# proxy itself never uses it — BYOK: the client's Authorization header is
# forwarded per-request. Must have NO spaces around `=` (compose env_file and
# `set -a; . ./.env` both reject/drop `KEY = value` forms silently).
OPENROUTER_API_KEY=

# SQLite remains the local fallback for non-ledger stats (PROXY_ROOT/data/stats.db);
# Postgres-backed features require TOKEN_SAVER_PG_DSN above.
