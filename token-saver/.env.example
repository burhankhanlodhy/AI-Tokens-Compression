# token-saver proxy configuration
# Copy to .env and fill in. NEVER commit the real .env.

# Upstream provider: OpenRouter (OpenAI-compatible). The client's own API key
# is forwarded per-request via the Authorization header — the proxy stores nothing.
UPSTREAM_BASE_URL=https://openrouter.ai/api/v1

# Feature flags
COMPRESSION_ENABLED=true
# Output conciseness: OFF by default per P1-1 benchmark (no reliable savings;
# benchmarked -1.53%/-2.45% mean output change on z-ai/glm-5.3-flash). The
# X-Token-Saver-Conciseness request header can enable it per-request.
OUTPUT_CONCISENESS_ENABLED=false

# Suppress hidden reasoning/thinking tokens on models that support them
# (e.g. glm-5.3-flash), unless the client's own request already sets a
# `reasoning` field. Reasoning-token spend is unpredictable and can dwarf
# anything compression saves, so this keeps cost estimates meaningful.
DISABLE_REASONING_BY_DEFAULT=true

# Compression tuning
LLMLINGUA_MODEL=microsoft/llmlingua-2-bert-base-multilingual-cased-meetingbank
COMPRESSION_RATE=0.6

# Storage: leave unset. The default (PROXY_ROOT/data/stats.db) already
# resolves correctly both inside Docker (WORKDIR /app) and for local runs.
